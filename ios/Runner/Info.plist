	<!-- google_mobile_ads' native iOS SDK crashes at plugin-registration time
	     (before any Dart code runs) if this key is missing entirely, even
	     though AdService never actually calls into it on iOS (see
	     AdService.isSupported). This is Google's own public iOS test App ID
	     — not this project's real one — purely to stop that crash; ads are
	     never requested or shown on iOS regardless. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
